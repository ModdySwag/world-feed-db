[19.229966, "o", "\u001b[1mNAME\u001b[0m\u001b[m\r\n    sfw search\u001b[m\r\n\u001b[m\r\n\u001b[1mSYNOPSIS\u001b[0m\u001b[m\r\n    sfw search \u001b[4mPRESET\u001b[0m <flags>\u001b[m\r\n\u001b[m\r\n\u001b[1mPOSITIONAL ARGUMENTS\u001b[0m\u001b[m\r\n    \u001b[1m\u001b[4mPRESET\u001b[0m\u001b[0m\u001b[m\r\n        string, the type of pre written camera you want. choose from: 1)\"webcamXP\" 2)\"MJPG 3)\"yawCam\"\u001b[m\r\n\u001b[m\r\n\u001b[1mFLAGS\u001b[0m\u001b[m\r\n    --check=\u001b[4mCHECK\u001b[0m\u001b[m\r\n        Default: True\u001b[m\r\n        boolean, indicates whether or not you want to check if the image is completly black or white.\u001b[m\r\n    --tag=\u001b[4mTAG\u001b[0m\u001b[m\r\n        Default: True\u001b[m\r\n        boolean, indicates whether or not you want to generate descriptions for the webcam.\u001b[m\r\n    --store=\u001b[4mSTORE\u001b[0m\u001b[m\r\n        Default: False\u001b[m\r\n    --loc=\u001b[4mLOC\u001b[0m\u001b[m\r\n        Default: True\u001b[m\r\n    --debug=\u001b[4mDEBUG\u001b[0m\u001b[m\r\n        Default: False\u001b[m\r\n        boolean, indicates whether or not you want to print debug info.\u001b[m\r\n\u001b[m\r\n\u001b[1mNOTES\u001b[0m\u001b[m\r\n    You can also use flags syntax for POSITIONAL ARGUMENTS\u001b[m\r\n\u001b[7m(END)\u001b[27m\u001b[K"]
